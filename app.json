{
  "name": "Quranm",
  "description": "A quiet space to memorize and revise the Quran.",
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "Quranm HTTP health",
        "path": "/api/health",
        "port": 5000,
        "content": "\"ok\":true",
        "initialDelay": 2,
        "attempts": 5,
        "timeout": 5
      }
    ]
  }
}
