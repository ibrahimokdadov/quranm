{
  "name": "@tilawa/core",
  "version": "0.3.1",
  "description": "Offline Quran verse recognition. Give it 16kHz audio, get surah:ayah. Pure TypeScript core with a pluggable ONNX runtime seam — works in web, node, and React Native.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yazinsai/tilawa.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yazinsai/tilawa#readme",
  "bugs": {
    "url": "https://github.com/yazinsai/tilawa/issues"
  },
  "author": "yazinsai",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "sync-docs": "cp ../../README.md README.md && cp ../../LICENSE LICENSE && cp ../../NOTICE.md NOTICE.md",
    "prepack": "npm run sync-docs && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "quran",
    "tarteel",
    "asr",
    "speech-recognition",
    "onnx",
    "offline",
    "arabic"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  },
  "sideEffects": false
}
